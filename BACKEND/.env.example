PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/campusmart
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Comma-separated trusted browser origins (no trailing slash). Set TRUST_PROXY=true behind one trusted reverse proxy.
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
ADMIN_EMAIL=your-existing-admin-account@example.com
# Optional Google Identity Services sign-in.
GOOGLE_CLIENT_ID=
# Optional SMTP delivery: configure either SMTP_URL or SMTP_HOST/SMTP_PORT/SMTP_SECURE/SMTP_USER/SMTP_PASSWORD.
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
FRONTEND_URL=http://localhost:5173
GEMINI_API_KEY=your_gemini_api_key
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
